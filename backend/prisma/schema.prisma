// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- CORE: Empresa, Usuarios, Roles, Permisos ----------

model Empresa {
  id            String   @id @default(uuid())
  nombre        String
  logoUrl       String?
  colorPrimario String?  @default("#0F172A")
  dominio       String?  @unique
  zonaHoraria   String   @default("America/Guayaquil")
  creadoEn      DateTime @default(now())

  sucursales Sucursal[]
  usuarios   Usuario[]
  modulos    EmpresaModulo[]
  roles      Rol[]

  clientes             Cliente[]
  productosServicio    ProductoServicio[]
  ordenes              Orden[]
  entidadesDinamicas   EntidadDinamica[]
  registrosAuditoria   RegistroAuditoria[]
  recursos             Recurso[]
  tiposCita            TipoCita[]
  citas                Cita[]
  categoriasActivo     CategoriaActivo[]
  activos              Activo[]
  asignacionesActivo   AsignacionActivo[]
  movimientosStock     MovimientoStock[]
  marcaciones          Marcacion[]
  categoriasMovimiento CategoriaMovimiento[]
  movimientosCuenta    MovimientoCuenta[]
  materiales           Material[]
  costeos              CosteoProyecto[]
  notificaciones       Notificacion[]
  proveedores          Proveedor[]
  ordenesCompra        OrdenCompra[]
  pagosNomina          PagoNomina[]
}

model Sucursal {
  id        String  @id @default(uuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  nombre    String
  direccion String?
  activa    Boolean @default(true)

  usuarios          Usuario[]
  recursos          Recurso[]
  activos           Activo[]
  movimientosCuenta MovimientoCuenta[]
}

model Usuario {
  id           String    @id @default(uuid())
  empresaId    String
  empresa      Empresa   @relation(fields: [empresaId], references: [id])
  nombre       String
  email        String    @unique
  passwordHash String
  fotoUrl      String?
  telefono     String?
  cargo        String?
  bio          String?
  activo       Boolean   @default(true)
  // false = todavía usa la contraseña aleatoria de la invitación (no puede iniciar sesión
  // hasta que la reemplace vía /reset-password). true por defecto porque los usuarios
  // sembrados o creados con una contraseña real ya la tienen "configurada" desde el inicio.
  passwordConfigurada Boolean @default(true)
  sucursalId   String?
  sucursal     Sucursal? @relation(fields: [sucursalId], references: [id])
  creadoEn     DateTime  @default(now())

  roles                  UsuarioRol[]
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  registrosAuditoria     RegistroAuditoria[]
  activosAsignados       AsignacionActivo[]   @relation("ActivoTitular")
  asignacionesRealizadas AsignacionActivo[]   @relation("ActivoAsignadoPor")
  movimientosStock       MovimientoStock[]
  marcaciones            Marcacion[]
  movimientosCuenta      MovimientoCuenta[]
  costeos                CosteoProyecto[]
  ordenes                Orden[]
  notificaciones         Notificacion[]
  ordenesCompra          OrdenCompra[]
  pagosNomina            PagoNomina[]         @relation("NominaEmpleado")
  pagosNominaRegistrados PagoNomina[]         @relation("NominaRegistradoPor")
}

model RegistroAuditoria {
  id        String   @id @default(uuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
  accion    String // "crear" | "actualizar" | "eliminar" | "activar" | "desactivar"
  entidad   String // "usuario" | "cliente" | "modulo" | "empresa" | "rol" | "entidad_dinamica:<clave>"
  entidadId String?
  detalle   Json?
  creadoEn  DateTime @default(now())
}

model RefreshToken {
  id             String   @id @default(uuid())
  usuarioId      String
  usuario        Usuario  @relation(fields: [usuarioId], references: [id])
  tokenHash      String   @unique
  sessionId      String
  inicioSesionEn DateTime @default(now())
  userAgent      String?
  ip             String?
  creadoEn       DateTime @default(now())
  expiraEn       DateTime
  revocado       Boolean  @default(false)
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  tokenHash String   @unique
  creadoEn  DateTime @default(now())
  expiraEn  DateTime
  usado     Boolean  @default(false)
}

model Rol {
  id          String   @id @default(uuid())
  empresaId   String? // null = rol de sistema (superadmin)
  empresa     Empresa? @relation(fields: [empresaId], references: [id])
  nombre      String
  descripcion String?

  usuarios UsuarioRol[]
  permisos RolPermiso[]

  @@unique([empresaId, nombre])
}

model UsuarioRol {
  usuarioId String
  rolId     String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  rol       Rol     @relation(fields: [rolId], references: [id])

  @@id([usuarioId, rolId])
}

model Permiso {
  id       String @id @default(uuid())
  clave    String @unique // ej: "inventario.crear", "citas.eliminar"
  etiqueta String

  roles RolPermiso[]
}

model RolPermiso {
  rolId     String
  permisoId String
  rol       Rol     @relation(fields: [rolId], references: [id])
  permiso   Permiso @relation(fields: [permisoId], references: [id])

  @@id([rolId, permisoId])
}

// ---------- MÓDULOS (catálogo + activación por empresa) ----------

model Modulo {
  id          String  @id @default(uuid())
  clave       String  @unique // "inventario", "citas", "facturacion"
  nombre      String
  descripcion String?

  empresas EmpresaModulo[]
}

model EmpresaModulo {
  empresaId String
  moduloId  String
  activo    Boolean @default(true)
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  modulo    Modulo  @relation(fields: [moduloId], references: [id])

  @@id([empresaId, moduloId])
}

// ---------- ENTIDADES DE NEGOCIO COMUNES (con extensión JSON) ----------

model Cliente {
  id             String   @id @default(uuid())
  empresaId      String
  empresa        Empresa  @relation(fields: [empresaId], references: [id])
  nombre         String
  email          String?
  telefono       String?
  atributosExtra Json?
  creadoEn       DateTime @default(now())

  ordenes           Orden[]
  citas             Cita[]
  activosAsignados  AsignacionActivo[]
  movimientosCuenta MovimientoCuenta[]
  costeos           CosteoProyecto[]
}

model ProductoServicio {
  id             String   @id @default(uuid())
  empresaId      String
  empresa        Empresa  @relation(fields: [empresaId], references: [id])
  tipo           String // "producto" | "servicio"
  nombre         String
  sku            String?
  precio         Decimal  @db.Decimal(10, 2)
  stock          Int? // null si es servicio
  stockMinimo    Int?
  unidadMedida   String   @default("unidad")
  atributosExtra Json?
  creadoEn       DateTime @default(now())

  movimientosStock MovimientoStock[]
  ordenItems       OrdenItem[]
  ordenCompraItems OrdenCompraItem[]
}

model Orden {
  id        String   @id @default(uuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  estado    String   @default("completada")
  total     Decimal  @db.Decimal(10, 2)
  notas     String?
  creadoEn  DateTime @default(now())

  items             OrdenItem[]
  movimientosCuenta MovimientoCuenta[]
}

model OrdenItem {
  id         String           @id @default(uuid())
  ordenId    String
  orden      Orden            @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  productoId String
  producto   ProductoServicio @relation(fields: [productoId], references: [id])
  cantidad   Int
  precioUnit Decimal          @db.Decimal(10, 2)
}

// ---------- MOTOR DE ENTIDADES DINÁMICAS (solo para lo muy propio del rubro) ----------

model EntidadDinamica {
  id        String  @id @default(uuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  clave     String // "mascota", "vehiculo", "equipo_alquiler"
  nombre    String

  campos    CampoDinamico[]
  registros RegistroDinamico[]

  @@unique([empresaId, clave])
}

model CampoDinamico {
  id        String          @id @default(uuid())
  entidadId String
  entidad   EntidadDinamica @relation(fields: [entidadId], references: [id])
  clave     String // "raza", "placa"
  etiqueta  String
  tipo      String // "texto" | "numero" | "fecha" | "booleano" | "select"
  requerido Boolean         @default(false)
  opciones  Json? // solo si tipo = "select"
  orden     Int             @default(0)

  @@unique([entidadId, clave])
}

model RegistroDinamico {
  id        String          @id @default(uuid())
  entidadId String
  entidad   EntidadDinamica @relation(fields: [entidadId], references: [id])
  valores   Json
  creadoEn  DateTime        @default(now())
}

// ---------- CITAS / CALENDARIO (genérico para cualquier rubro) ----------

model Recurso {
  id         String    @id @default(uuid())
  empresaId  String
  empresa    Empresa   @relation(fields: [empresaId], references: [id])
  tipo       String // "persona" | "sala" | "equipo"
  nombre     String
  usuarioId  String? // opcional: si el recurso es un empleado con cuenta propia
  sucursalId String?
  sucursal   Sucursal? @relation(fields: [sucursalId], references: [id])
  activo     Boolean   @default(true)
  creadoEn   DateTime  @default(now())

  horarios HorarioAtencion[]
  citas    Cita[]
}

model HorarioAtencion {
  id         String  @id @default(uuid())
  recursoId  String
  recurso    Recurso @relation(fields: [recursoId], references: [id])
  diaSemana  Int // 0 = domingo … 6 = sábado
  horaInicio String // "09:00"
  horaFin    String // "18:00"
}

model TipoCita {
  id              String  @id @default(uuid())
  empresaId       String
  empresa         Empresa @relation(fields: [empresaId], references: [id])
  nombre          String
  duracionMinutos Int
  bufferMinutos   Int     @default(0)
  color           String  @default("#0F172A")
  activo          Boolean @default(true)

  citas Cita[]
}

model Cita {
  id                  String   @id @default(uuid())
  empresaId           String
  empresa             Empresa  @relation(fields: [empresaId], references: [id])
  clienteId           String?
  cliente             Cliente? @relation(fields: [clienteId], references: [id])
  recursoId           String
  recurso             Recurso  @relation(fields: [recursoId], references: [id])
  tipoCitaId          String
  tipoCita            TipoCita @relation(fields: [tipoCitaId], references: [id])
  fechaInicio         DateTime
  fechaFin            DateTime
  estado              String   @default("pendiente") // pendiente|confirmada|cancelada|completada|no_asistio
  notas               String?
  recordatorioEnviado Boolean  @default(false)
  creadoEn            DateTime @default(now())
}

// ---------- INVENTARIO (activos con historial de dueño + stock por cantidad) ----------

model CategoriaActivo {
  id        String  @id @default(uuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  nombre    String
  activo    Boolean @default(true)

  activos Activo[]

  @@unique([empresaId, nombre])
}

model Activo {
  id                String          @id @default(uuid())
  empresaId         String
  empresa           Empresa         @relation(fields: [empresaId], references: [id])
  categoriaActivoId String
  categoriaActivo   CategoriaActivo @relation(fields: [categoriaActivoId], references: [id])
  nombre            String
  codigoInterno     String?
  numeroSerie       String?
  estado            String          @default("disponible") // disponible|asignado|baja
  valorCompra       Decimal?        @db.Decimal(10, 2)
  fechaCompra       DateTime?
  sucursalId        String?
  sucursal          Sucursal?       @relation(fields: [sucursalId], references: [id])
  notas             String?
  creadoEn          DateTime        @default(now())

  asignaciones AsignacionActivo[]

  @@unique([empresaId, codigoInterno])
}

model AsignacionActivo {
  id              String    @id @default(uuid())
  empresaId       String
  empresa         Empresa   @relation(fields: [empresaId], references: [id])
  activoId        String
  activo          Activo    @relation(fields: [activoId], references: [id])
  usuarioId       String?
  usuario         Usuario?  @relation("ActivoTitular", fields: [usuarioId], references: [id])
  clienteId       String?
  cliente         Cliente?  @relation(fields: [clienteId], references: [id])
  fechaAsignacion DateTime  @default(now())
  fechaDevolucion DateTime?
  notas           String?
  asignadoPorId   String
  asignadoPor     Usuario   @relation("ActivoAsignadoPor", fields: [asignadoPorId], references: [id])
  creadoEn        DateTime  @default(now())
}

model MovimientoStock {
  id         String           @id @default(uuid())
  empresaId  String
  empresa    Empresa          @relation(fields: [empresaId], references: [id])
  productoId String
  producto   ProductoServicio @relation(fields: [productoId], references: [id])
  tipo       String // "entrada" | "salida" | "ajuste"
  cantidad   Int
  motivo     String?
  usuarioId  String
  usuario    Usuario          @relation(fields: [usuarioId], references: [id])
  creadoEn   DateTime         @default(now())
}

// ---------- ASISTENCIA (entrada/salida/comida con geolocalización) ----------

model Marcacion {
  id        String   @id @default(uuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  tipo      String // "entrada" | "salida" | "inicio_comida" | "fin_comida"
  latitud   Float?
  longitud  Float?
  precision Float? // precisión del GPS en metros
  creadoEn  DateTime @default(now())
}

// ---------- CUENTAS (ingresos y egresos) ----------

model CategoriaMovimiento {
  id        String  @id @default(uuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  tipo      String // "ingreso" | "egreso"
  nombre    String
  activo    Boolean @default(true)

  movimientos MovimientoCuenta[]

  @@unique([empresaId, tipo, nombre])
}

model MovimientoCuenta {
  id                String              @id @default(uuid())
  empresaId         String
  empresa           Empresa             @relation(fields: [empresaId], references: [id])
  tipo              String // "ingreso" | "egreso"
  categoriaId       String
  categoria         CategoriaMovimiento @relation(fields: [categoriaId], references: [id])
  monto             Decimal             @db.Decimal(10, 2)
  fecha             DateTime
  descripcion       String?
  metodoPago        String?
  numeroComprobante String?
  comprobanteUrl    String?
  clienteId         String?
  cliente           Cliente?            @relation(fields: [clienteId], references: [id])
  usuarioId         String
  usuario           Usuario             @relation(fields: [usuarioId], references: [id])
  costeoProyectoId  String?
  costeoProyecto    CosteoProyecto?     @relation(fields: [costeoProyectoId], references: [id], onDelete: Cascade)
  ordenId           String?
  orden             Orden?              @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  ordenCompraId     String?
  ordenCompra       OrdenCompra?        @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  pagoNominaId      String?
  pagoNomina        PagoNomina?         @relation(fields: [pagoNominaId], references: [id], onDelete: Cascade)
  sucursalId        String?
  sucursal          Sucursal?           @relation(fields: [sucursalId], references: [id])
  creadoEn          DateTime            @default(now())
}

// ---------- COSTEO (calculadora de costos por partes y materiales, ej. cosplay) ----------

model Material {
  id             String   @id @default(uuid())
  empresaId      String
  empresa        Empresa  @relation(fields: [empresaId], references: [id])
  nombre         String
  calidad        String?
  unidadMedida   String
  precioUnitario Decimal  @db.Decimal(10, 2)
  activo         Boolean  @default(true)
  creadoEn       DateTime @default(now())

  lineas CosteoParteMaterial[]
}

model CosteoProyecto {
  id                 String    @id @default(uuid())
  empresaId          String
  empresa            Empresa   @relation(fields: [empresaId], references: [id])
  nombre             String
  clienteId          String?
  cliente            Cliente?  @relation(fields: [clienteId], references: [id])
  tarifaHora         Decimal   @db.Decimal(10, 2)
  margenPorcentaje   Decimal   @default(0) @db.Decimal(6, 2)
  otrosCostos        Decimal   @default(0) @db.Decimal(10, 2)
  notas              String?
  estado             String    @default("borrador") // "borrador" | "vendido"
  precioVenta        Decimal?  @db.Decimal(10, 2)
  costoTotalSnapshot Decimal?  @db.Decimal(10, 2) // costo real al momento de vender, para calcular la ganancia sin recalcular partes/materiales
  fechaVenta         DateTime?
  usuarioId          String
  usuario            Usuario   @relation(fields: [usuarioId], references: [id])
  creadoEn           DateTime  @default(now())

  partes            CosteoParte[]
  movimientosCuenta MovimientoCuenta[]
}

model CosteoParte {
  id         String         @id @default(uuid())
  proyectoId String
  proyecto   CosteoProyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  nombre     String
  horas      Decimal        @default(0) @db.Decimal(6, 2)
  orden      Int            @default(0)

  materiales CosteoParteMaterial[]
}

model CosteoParteMaterial {
  id                     String      @id @default(uuid())
  parteId                String
  parte                  CosteoParte @relation(fields: [parteId], references: [id], onDelete: Cascade)
  materialId             String
  material               Material    @relation(fields: [materialId], references: [id])
  cantidad               Decimal     @db.Decimal(10, 2)
  precioUnitarioSnapshot Decimal     @db.Decimal(10, 2)
}

// ---------- NOTIFICACIONES (centro de notificaciones dentro de la app) ----------

model Notificacion {
  id        String   @id @default(uuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  usuarioId String? // null = para todos los usuarios de la empresa
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
  tipo      String // "stock_bajo" | "cita_asignada" | ...
  titulo    String
  mensaje   String
  enlace    String? // ruta del frontend a la que lleva, ej. "/productos"
  leida     Boolean  @default(false)
  creadoEn  DateTime @default(now())
}

// ---------- PROVEEDORES Y ÓRDENES DE COMPRA ----------

model Proveedor {
  id        String   @id @default(uuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  nombre    String
  contacto  String?
  telefono  String?
  email     String?
  notas     String?
  latitud   Float?
  longitud  Float?
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())

  ordenesCompra OrdenCompra[]
}

model OrdenCompra {
  id             String    @id @default(uuid())
  empresaId      String
  empresa        Empresa   @relation(fields: [empresaId], references: [id])
  proveedorId    String
  proveedor      Proveedor @relation(fields: [proveedorId], references: [id])
  usuarioId      String
  usuario        Usuario   @relation(fields: [usuarioId], references: [id])
  estado         String    @default("pendiente") // "pendiente" | "recibida" | "cancelada"
  total          Decimal   @db.Decimal(10, 2)
  notas          String?
  fechaRecepcion DateTime?
  creadoEn       DateTime  @default(now())

  items             OrdenCompraItem[]
  movimientosCuenta MovimientoCuenta[]
}

model OrdenCompraItem {
  id            String           @id @default(uuid())
  ordenCompraId String
  ordenCompra   OrdenCompra      @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  productoId    String
  producto      ProductoServicio @relation(fields: [productoId], references: [id])
  cantidad      Int
  precioUnit    Decimal          @db.Decimal(10, 2)
}

// ---------- NÓMINA (registro simple de pagos a empleados) ----------

model PagoNomina {
  id              String   @id @default(uuid())
  empresaId       String
  empresa         Empresa  @relation(fields: [empresaId], references: [id])
  empleadoId      String
  empleado        Usuario  @relation("NominaEmpleado", fields: [empleadoId], references: [id])
  periodo         String // "2026-09" (año-mes al que corresponde el pago)
  sueldoBase      Decimal  @db.Decimal(10, 2)
  bonos           Decimal  @default(0) @db.Decimal(10, 2)
  descuentos      Decimal  @default(0) @db.Decimal(10, 2)
  totalPagado     Decimal  @db.Decimal(10, 2) // snapshot: sueldoBase + bonos - descuentos
  fechaPago       DateTime
  notas           String?
  registradoPorId String
  registradoPor   Usuario  @relation("NominaRegistradoPor", fields: [registradoPorId], references: [id])
  creadoEn        DateTime @default(now())

  movimientosCuenta MovimientoCuenta[]
}
